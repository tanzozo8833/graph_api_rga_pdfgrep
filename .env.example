# Microsoft Entra ID app registration
CLIENT_ID=
TENANT_ID=

# Create a client secret in Azure portal → App registrations → Certificates & secrets
CLIENT_SECRET=

# Flask session key — any random string is fine locally
FLASK_SECRET_KEY=

# Anthropic API key for the OneDrive search agent
ANTHROPIC_API_KEY=
# Optional: override model (default claude-sonnet-4-5)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# ANTHROPIC_MODEL=claude-sonnet-4-5

